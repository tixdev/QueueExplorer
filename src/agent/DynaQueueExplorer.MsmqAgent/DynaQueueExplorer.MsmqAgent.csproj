<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- MSMQ only exists on Windows: the agent uses its COM API (mqoa.dll) and performance counters. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>DynaQueueExplorer.MsmqAgent</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- LibraryImport (mqrt.dll) -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\server\DynaQueueExplorer.Core\DynaQueueExplorer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DynaQueueExplorer.Tests" />
  </ItemGroup>

</Project>
